<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Assets\Textures\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageReference Include="StbImageSharp" Version="2.30.15"/>
    <PackageReference Include="SubC.AllegroDotNet" Version="0.12.0"/>
    <PackageReference Include="SubC.AllegroDotNet.Win64" Version="5.2.11.2"/>
  </ItemGroup>

  <ItemGroup>
<!--    <None Update="Assets\Fonts\*.ttf">-->
<!--      <CopyToOutputDirectory>Always</CopyToOutputDirectory>-->
<!--    </None>-->
<!--    <None Update="Assets\Audio\*.ogg">-->
<!--      <CopyToOutputDirectory>Always</CopyToOutputDirectory>-->
<!--    </None>-->
<!--    <None Update="Assets\Textures\*.png">-->
<!--      <CopyToOutputDirectory>Always</CopyToOutputDirectory>-->
<!--    </None>-->
    
    <EmbeddedResource Include="Assets/Fonts/*.ttf" LogicalName="Assets/Fonts/%(Filename)%(Extension)"/>
    <EmbeddedResource Include="Assets/Audio/*.ogg" LogicalName="Assets/Audio/%(Filename)%(Extension)"/>
    <EmbeddedResource Include="Assets/Textures/*.png" LogicalName="Assets/Textures/%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup><!--      <None Update="Lib\*.dll">-->
    <!--        <Link>%(Filename)%(Extension)</Link>-->
    <!--        <CopyToOutputDirectory>Always</CopyToOutputDirectory>-->
    <!--      </None>-->

    <ProjectReference Include="..\InstaPoker.Core\InstaPoker.Core.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\instapoker-server.crt" Link="Certs\server.crt">
      <LogicalName>InstaPoker.Client.Certs.server.crt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
